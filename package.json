{
  "name": "devyantra-ui",
  "version": "1.0.0",
  "description": "A comprehensive suite of developer tools including text comparison, JSON formatting, encoding utilities, and more",
  "private": false,
  "type": "module",
  "author": "DevYantra Team",
  "license": "MIT",
  "homepage": "https://github.com/sg-open/devyantra-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sg-open/devyantra-ui.git"
  },
  "bugs": {
    "url": "https://github.com/sg-open/devyantra-ui/issues"
  },
  "keywords": [
    "developer-tools",
    "text-comparison",
    "diff-viewer",
    "json-formatter",
    "base64-encoder",
    "hash-generator",
    "jwt-decoder",
    "vue3",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "generate:og": "node scripts/generate-og-image.js",
    "prerender": "node scripts/prerender.js",
    "build:seo": "run-p type-check \"build-only {@}\" -- && node scripts/prerender.js"
  },
  "dependencies": {
    "diff": "^8.0.3",
    "diff2html": "^3.4.56",
    "js-beautify": "^1.15.4",
    "lz-string": "^1.5.0",
    "pinia": "^3.0.3",
    "primeicons": "^7.0.0",
    "sql-formatter": "^15.7.1",
    "vue": "^3.5.28",
    "vue-router": "^5.0.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.1.13",
    "@tailwindcss/typography": "^0.5.19",
    "@tsconfig/node22": "^22.0.2",
    "@types/js-beautify": "^1.14.3",
    "@types/lz-string": "^1.3.34",
    "@types/node": "^25.3.0",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "autoprefixer": "^10.4.21",
    "eslint": "^10.0.2",
    "eslint-plugin-vue": "~10.8.0",
    "jiti": "^2.4.2",
    "jsdom": "^29.0.0",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.55.0",
    "postcss": "^8.5.6",
    "prettier": "^3.8.1",
    "serve-handler": "^6.1.6",
    "tailwindcss": "^4.1.13",
    "typescript": "~5.9.3",
    "vite": "^7.3.1",
    "vite-plugin-vue-devtools": "^8.0.0",
    "vitest": "^4.0.18",
    "vue-tsc": "^3.2.4"
  }
}
