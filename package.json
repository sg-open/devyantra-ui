{
  "name": "devyantra-ui",
  "version": "1.0.0",
  "description": "A comprehensive suite of developer tools including text comparison, JSON formatting, encoding utilities, and more",
  "private": false,
  "type": "module",
  "author": "DevYantra Team",
  "license": "MIT",
  "homepage": "https://github.com/sg-open/devyantra-ui#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sg-open/devyantra-ui.git"
  },
  "bugs": {
    "url": "https://github.com/sg-open/devyantra-ui/issues"
  },
  "keywords": [
    "developer-tools",
    "text-comparison",
    "diff-viewer",
    "json-formatter",
    "base64-encoder",
    "hash-generator",
    "jwt-decoder",
    "vue3",
    "typescript",
    "vite"
  ],
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint": "eslint . --fix",
    "format": "prettier --write src/",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest --coverage",
    "test:e2e": "playwright test",
    "test:e2e:ui": "playwright test --ui",
    "test:e2e:headed": "playwright test --headed",
    "test:e2e:debug": "playwright test --debug",
    "generate:og": "node scripts/generate-og-image.js",
    "generate:icons": "node scripts/generate-icons.js",
    "prerender": "node scripts/prerender.js",
    "build:seo": "run-p type-check \"build-only {@}\" -- && node scripts/prerender.js"
  },
  "dependencies": {
    "diff": "^9.0.0",
    "js-beautify": "^1.15.4",
    "lz-string": "^1.5.0",
    "pinia": "^3.0.4",
    "primeicons": "^7.0.0",
    "sql-formatter": "^15.7.3",
    "vue": "^3.5.32",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@playwright/test": "^1.59.1",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/postcss": "^4.2.2",
    "@tailwindcss/typography": "^0.5.19",
    "@tsconfig/node22": "^22.0.5",
    "@types/js-beautify": "^1.14.3",
    "@types/lz-string": "^1.5.0",
    "@types/node": "^26.0.1",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.7.0",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.9.1",
    "autoprefixer": "^10.4.27",
    "eslint": "^10.2.0",
    "eslint-plugin-vue": "~10.9.2",
    "jiti": "^2.6.1",
    "jsdom": "^29.0.2",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.59.1",
    "postcss": "^8.5.9",
    "prettier": "^3.8.2",
    "serve-handler": "^6.1.7",
    "tailwindcss": "^4.2.2",
    "typescript": "~6.0.2",
    "vite": "^8.0.8",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.4",
    "vue-tsc": "^3.2.6"
  }
}
